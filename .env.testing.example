# Konfigurasi khusus test suite.
# Dibuat supaya `php artisan test` dengan RefreshDatabase TIDAK menghapus database dev
# yang dipakai .env. Database di bawah ini boleh di-drop/di-migrate ulang kapan saja.
# Copy jadi .env.testing, lalu isi kredensial sandbox di bawah.
# .env.testing di-gitignore supaya kredensial tidak ikut ter-commit.

APP_NAME="Zillenial Action (Testing)"
APP_ENV=testing
APP_KEY=base64:Zmpyd2JxN0h0UWxYc0RhOFZjTnBLZTJ5TXg0UjFnVTA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_zillenial_action_test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS="test@example.test"
MAIL_FROM_NAME="Zillenial Action Testing"

# Host-nya harus tetap mengandung "chatkebaikan": test suite memasang Http::fake('*chatkebaikan*').
# Tidak ada panggilan nyata ke host ini selama test karena semuanya di-fake.
CHATKEBAIKAN_BASE_URL=https://chatkebaikan.raihmimpi.id
CHATKEBAIKAN_VALIDATE_PATH=/api/dr/voucher/validate/{kode}
CHATKEBAIKAN_REDEEM_URL=https://chatkebaikan.raihmimpi.id/api/dr/voucher/redeem
CHATKEBAIKAN_REDEEM_METHOD=POST
CHATKEBAIKAN_TIMEOUT=5

MIDTRANS_SERVER_KEY=
# Butuh server/client key Midtrans SANDBOX asli: CheckoutExternalRedeemTest
# menembak snap token lewat SDK Midtrans (tidak lewat Http::fake Laravel).
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

FRONTEND_URL=http://localhost:4321
PUBLIC_BACKEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:4321
SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DOMAIN=localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
PUBLIC_GOOGLE_AUTH_ENABLED=false
